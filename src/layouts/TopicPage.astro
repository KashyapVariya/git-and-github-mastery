---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import LevelBadge from '../components/ui/LevelBadge.astro';
import Icon from '../components/ui/Icon.astro';
import Callout from '../components/ui/Callout.astro';
import Pre from '../components/ui/Pre.astro';
import TopicCard from '../components/topic/TopicCard.astro';
import CompleteCheckbox from '../components/topic/CompleteCheckbox.tsx';
import { subtabLabel, url } from '../lib/nav';

interface Props {
  entry: CollectionEntry<'topics'>;
}

const { entry } = Astro.props;
const { title, summary, level, primaryTab, subtab, category, tags, sources, readingTime, related, lastReviewed } = entry.data;
const isWorkflows = primaryTab === 'workflows';
const basePath = isWorkflows ? '/workflows' : `/${primaryTab}/${subtab}`;

const { Content } = await render(entry);

const allTopics = await getCollection('topics', ({ data }) => !data.draft);
const siblings = allTopics
  .filter((t) => t.data.primaryTab === primaryTab && t.data.subtab === subtab)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const idx = siblings.findIndex((t) => t.id === entry.id);
const prev = idx > 0 ? siblings[idx - 1] : null;
const next = idx < siblings.length - 1 ? siblings[idx + 1] : null;

const relatedEntries = allTopics.filter((t) => related.includes(t.id.split('/').pop()!) || related.includes(t.id));

const formattedDate = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(lastReviewed);

const mdxComponents = { Callout, pre: Pre };
---

<Layout title={title} description={summary} primaryTab={primaryTab} subtab={subtab}>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-1.5 text-[13px] text-[var(--color-ink-faint)]">
      <a href={url(basePath)} class="capitalize transition hover:text-[var(--color-git-orange-soft)]">{primaryTab}</a>
      {!isWorkflows && (
        <>
          <Icon name="chevron-right" size={12} />
          <a href={url(basePath)} class="transition hover:text-[var(--color-git-orange-soft)]">{subtabLabel(primaryTab, subtab)}</a>
        </>
      )}
      <Icon name="chevron-right" size={12} />
      <span class="truncate text-[var(--color-ink-muted)]">{title}</span>
    </nav>

    <header data-reveal class="mb-8">
      <div class="mb-4 flex flex-wrap items-center gap-2">
        <LevelBadge level={level} />
        <span class="chip"><Icon name="clock" size={12} />{readingTime} min read</span>
        <span class="chip"><Icon name="tag" size={12} />{category}</span>
      </div>
      <h1 class="text-[2rem] font-bold leading-tight tracking-tight text-[var(--color-ink)] sm:text-[2.5rem]">{title}</h1>
      <p class="mt-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-4 py-3 text-[15px] leading-relaxed text-[var(--color-ink-muted)]">
        <strong class="text-[var(--color-ink)]">In one sentence:</strong> {summary}
      </p>
      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((t) => <span class="chip !text-[11px]">{t}</span>)}
        </div>
      )}
    </header>

    <div
      data-reveal
      class="prose-topic max-w-none text-[15.5px] leading-[1.75] text-[var(--color-ink-muted)]
        [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-[var(--color-ink)]
        [&_h3]:mt-7 [&_h3]:mb-2 [&_h3]:text-[17px] [&_h3]:font-semibold [&_h3]:text-[var(--color-ink)]
        [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1.5 [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:space-y-1.5
        [&_a]:text-[var(--color-git-orange-soft)] [&_a]:underline [&_a]:underline-offset-2
        [&_strong]:text-[var(--color-ink)] [&_strong]:font-semibold
        [&_:not(pre)>code]:inline-code
        [&_table]:w-full [&_table]:my-5 [&_table]:border-collapse [&_table]:overflow-hidden [&_table]:rounded-xl [&_table]:border [&_table]:border-[var(--color-border)]
        [&_th]:bg-[var(--color-bg-elevated)] [&_th]:text-left [&_th]:text-[13px] [&_th]:font-semibold [&_th]:text-[var(--color-ink)] [&_th]:px-3 [&_th]:py-2 [&_th]:border-b [&_th]:border-[var(--color-border)]
        [&_td]:px-3 [&_td]:py-2 [&_td]:text-[13.5px] [&_td]:border-b [&_td]:border-[var(--color-border-soft)]
        [&_blockquote]:border-l-2 [&_blockquote]:border-[var(--color-git-orange)] [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-[var(--color-ink-muted)]"
    >
      <Content components={mdxComponents} />
    </div>

    <div data-reveal class="mt-10 gradient-border p-5">
      <p class="mb-3 flex items-center gap-2 text-[13px] font-semibold uppercase tracking-wide text-[var(--color-ink-faint)]">
        <Icon name="book" size={14} /> Learn more
      </p>
      <ul class="space-y-2">
        {sources.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener" class="flex items-center gap-1.5 text-[14px] text-[var(--color-git-orange-soft)] underline underline-offset-2 hover:text-[var(--color-git-orange)]">
              {s.label} <Icon name="external-link" size={12} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div data-reveal class="mt-6">
      <CompleteCheckbox slug={entry.id} client:visible />
    </div>

    {relatedEntries.length > 0 && (
      <section data-reveal class="mt-12">
        <h2 class="mb-4 text-lg font-bold text-[var(--color-ink)]">Related topics</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {relatedEntries.map((t) => (
            <TopicCard
              title={t.data.title}
              summary={t.data.summary}
              level={t.data.level}
              href={`/${t.data.primaryTab}/${t.data.subtab}/${t.id.split('/').pop()}`}
              readingTime={t.data.readingTime}
              compact
            />
          ))}
        </div>
      </section>
    )}

    <nav class="mt-12 grid gap-3 border-t border-[var(--color-border)] pt-6 sm:grid-cols-2" aria-label="Topic navigation">
      {prev ? (
        <a href={url(`${basePath}/${prev.id.split('/').pop()}`)} class="glass-card flex items-center gap-3 p-4">
          <Icon name="arrow-left" size={16} class="text-[var(--color-ink-faint)]" />
          <div class="min-w-0">
            <p class="text-[11px] uppercase tracking-wide text-[var(--color-ink-faint)]">Previous</p>
            <p class="truncate text-sm font-medium text-[var(--color-ink)]">{prev.data.title}</p>
          </div>
        </a>
      ) : <div />}
      {next && (
        <a href={url(`${basePath}/${next.id.split('/').pop()}`)} class="glass-card flex items-center justify-end gap-3 p-4 text-right">
          <div class="min-w-0">
            <p class="text-[11px] uppercase tracking-wide text-[var(--color-ink-faint)]">Next</p>
            <p class="truncate text-sm font-medium text-[var(--color-ink)]">{next.data.title}</p>
          </div>
          <Icon name="arrow-right" size={16} class="text-[var(--color-ink-faint)]" />
        </a>
      )}
    </nav>

    <p class="mt-8 text-xs text-[var(--color-ink-faint)]">Last reviewed {formattedDate}.</p>
  </article>
</Layout>
