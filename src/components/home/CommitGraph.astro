---
// Looping, pure-CSS animated commit graph: main branch with a feature
// branch that splits off and merges back in. No JS required.
---

<div class="gradient-border grid h-full place-items-center overflow-hidden p-6">
  <svg viewBox="0 0 360 220" class="graph-svg h-full w-full max-w-[420px]" aria-hidden="true">
    <defs>
      <filter id="glow" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="3.2" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <g class="graph-fade">
      <!-- main line segments -->
      <path class="ln ln-m1" d="M40,170 L120,170" stroke="#f05032" />
      <path class="ln ln-m2" d="M120,170 L200,170" stroke="#f05032" />
      <path class="ln ln-m3" d="M200,170 L280,170" stroke="#f05032" />

      <!-- branch up + feature line -->
      <path class="ln ln-up" d="M120,170 Q150,170 150,140 L150,110" stroke="#22d3ee" />
      <path class="ln ln-f1" d="M150,110 L220,110" stroke="#22d3ee" />

      <!-- merge line back down -->
      <path class="ln ln-merge" d="M220,110 Q260,110 260,140 L260,170" stroke="#8b6cf5" />

      <!-- nodes -->
      <circle class="nd nd-m1" cx="40" cy="170" r="6" fill="#f05032" filter="url(#glow)" />
      <circle class="nd nd-m2" cx="120" cy="170" r="6" fill="#f05032" filter="url(#glow)" />
      <circle class="nd nd-f1" cx="150" cy="110" r="5.5" fill="#22d3ee" filter="url(#glow)" />
      <circle class="nd nd-f2" cx="220" cy="110" r="5.5" fill="#22d3ee" filter="url(#glow)" />
      <circle class="nd nd-m3" cx="200" cy="170" r="6" fill="#f05032" filter="url(#glow)" />
      <circle class="nd nd-m4" cx="260" cy="170" r="7.5" fill="#8b6cf5" filter="url(#glow)" />
      <circle class="nd nd-m5" cx="300" cy="170" r="6" fill="#f05032" filter="url(#glow)" />
      <path class="ln ln-m4" d="M260,170 L300,170" stroke="#f05032" />

      <text x="150" y="94" class="label" fill="#22d3ee">feature</text>
      <text x="40" y="192" class="label" fill="#f05032">main</text>
    </g>
  </svg>
</div>

<style>
  .graph-svg .ln {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 140;
    stroke-dashoffset: 140;
  }
  .graph-svg .nd {
    opacity: 0;
    transform-origin: center;
    transform-box: fill-box;
  }
  .graph-svg .label {
    font-size: 10px;
    font-family: var(--font-mono);
    opacity: 0;
  }

  .graph-fade {
    animation: graph-fade 7s ease-in-out infinite;
  }
  @keyframes graph-fade {
    0% { opacity: 0; }
    5% { opacity: 1; }
    93% { opacity: 1; }
    100% { opacity: 0; }
  }

  .ln-m1 { animation: draw 0.5s ease-out 0.1s infinite; animation-timing-function: linear; animation-duration: 7s; }
  .ln-m2 { animation: draw-m2 7s linear infinite; }
  .ln-up { animation: draw-up 7s linear infinite; }
  .ln-f1 { animation: draw-f1 7s linear infinite; }
  .ln-merge { animation: draw-merge 7s linear infinite; }
  .ln-m3 { animation: draw-m3 7s linear infinite; }
  .ln-m4 { animation: draw-m4 7s linear infinite; }

  @keyframes draw { 0%, 2% { stroke-dashoffset: 140; } 14% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 0; } }
  @keyframes draw-m2 { 0%, 12% { stroke-dashoffset: 140; } 24% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 0; } }
  @keyframes draw-up { 0%, 13% { stroke-dashoffset: 140; } 24% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 0; } }
  @keyframes draw-f1 { 0%, 25% { stroke-dashoffset: 140; } 36% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 0; } }
  @keyframes draw-m3 { 0%, 24% { stroke-dashoffset: 140; } 36% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 0; } }
  @keyframes draw-merge { 0%, 37% { stroke-dashoffset: 140; } 48% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 0; } }
  @keyframes draw-m4 { 0%, 47% { stroke-dashoffset: 140; } 56% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 0; } }

  .nd-m1 { animation: pop 7s linear infinite; animation-delay: 0s; }
  .nd-m2 { animation: pop-at-12 7s linear infinite; }
  .nd-f1 { animation: pop-at-24 7s linear infinite; }
  .nd-m3 { animation: pop-at-24 7s linear infinite; }
  .nd-f2 { animation: pop-at-36 7s linear infinite; }
  .nd-m4 { animation: pop-merge 7s linear infinite; }
  .nd-m5 { animation: pop-at-56 7s linear infinite; }

  @keyframes pop { 0%, 1% { opacity: 0; transform: scale(0.4); } 4% { opacity: 1; transform: scale(1); } 100% { opacity: 1; transform: scale(1); } }
  @keyframes pop-at-12 { 0%, 11% { opacity: 0; transform: scale(0.4); } 14% { opacity: 1; transform: scale(1); } 100% { opacity: 1; transform: scale(1); } }
  @keyframes pop-at-24 { 0%, 23% { opacity: 0; transform: scale(0.4); } 26% { opacity: 1; transform: scale(1); } 100% { opacity: 1; transform: scale(1); } }
  @keyframes pop-at-36 { 0%, 35% { opacity: 0; transform: scale(0.4); } 38% { opacity: 1; transform: scale(1); } 100% { opacity: 1; transform: scale(1); } }
  @keyframes pop-at-56 { 0%, 55% { opacity: 0; transform: scale(0.4); } 58% { opacity: 1; transform: scale(1); } 100% { opacity: 1; transform: scale(1); } }
  @keyframes pop-merge {
    0%, 46% { opacity: 0; transform: scale(0.4); }
    50% { opacity: 1; transform: scale(1.3); }
    56% { transform: scale(1); }
    88% { transform: scale(1); opacity: 1; }
    92% { transform: scale(1.25); }
    100% { opacity: 1; transform: scale(1); }
  }

  .label { animation: label-fade 7s linear infinite; }
  @keyframes label-fade { 0%, 3% { opacity: 0; } 8% { opacity: 0.85; } 100% { opacity: 0.85; } }

  @media (prefers-reduced-motion: reduce) {
    .graph-fade, .ln, .nd, .label {
      animation: none !important;
      opacity: 1 !important;
      stroke-dashoffset: 0 !important;
      transform: none !important;
    }
  }
</style>
