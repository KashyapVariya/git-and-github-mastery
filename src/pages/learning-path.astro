---
import Layout from '../layouts/Layout.astro';
import LearningPathBoard from '../components/learning-path/LearningPathBoard.tsx';
import { learningPlans } from '../data/learning-path';
---

<Layout title="Learning Path" description="Guided 4-week and 8-week plans to go from your first commit to confident, automated collaboration." primaryTab="learning-path">
  <div class="mx-auto max-w-[900px] px-4 py-10 sm:px-6 sm:py-14">
    <div data-reveal class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-[var(--color-ink)] sm:text-4xl">Learning Path</h1>
      <p class="mt-3 text-[15px] leading-relaxed text-[var(--color-ink-muted)]">
        Structure beats randomness. Pick a pace, work through it stage by stage, and check off tasks as you go — your progress is saved on this device.
      </p>
    </div>

    <div class="plan-tabs" data-reveal>
      <input type="radio" name="plan" id="plan-4-week" class="sr-only" checked />
      <input type="radio" name="plan" id="plan-8-week" class="sr-only" />

      <div class="mb-10 flex gap-2">
        <label for="plan-4-week" data-target="4-week" class="tab-label chip cursor-pointer select-none !px-4 !py-2 !text-[13px]">4-Week Fast Track</label>
        <label for="plan-8-week" data-target="8-week" class="tab-label chip cursor-pointer select-none !px-4 !py-2 !text-[13px]">8-Week Deep Dive</label>
      </div>

      {learningPlans.map((plan) => (
        <div class="plan-panel" data-panel={plan.id}>
          <p class="mb-8 text-[14px] text-[var(--color-ink-muted)]">{plan.tagline}</p>
          <LearningPathBoard plan={plan} client:load />
        </div>
      ))}
    </div>
  </div>
</Layout>

<style>
  .plan-tabs .plan-panel { display: none; }
  .plan-tabs:has(#plan-4-week:checked) .plan-panel[data-panel='4-week'] { display: block; }
  .plan-tabs:has(#plan-8-week:checked) .plan-panel[data-panel='8-week'] { display: block; }

  .plan-tabs:has(#plan-4-week:checked) label[data-target='4-week'],
  .plan-tabs:has(#plan-8-week:checked) label[data-target='8-week'] {
    border-color: color-mix(in srgb, var(--color-git-orange) 50%, var(--color-border));
    background: color-mix(in srgb, var(--color-git-orange) 12%, var(--color-bg-elevated));
    color: var(--color-git-orange-soft);
  }
</style>
