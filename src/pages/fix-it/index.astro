---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DecisionTree from '../../components/fixit/DecisionTree.tsx';
import FixList from '../../components/fixit/FixList.tsx';
import { url } from '../../lib/nav';

const fixes = (await getCollection('fixes')).sort((a, b) => a.data.order - b.data.order);
const entries = fixes.map((f) => ({ slug: f.id.split('/').pop()!, title: f.data.title, symptom: f.data.symptom, severity: f.data.severity }));
---

<Layout title="Fix It" description="Made a Git mistake? Find the exact fix with a searchable list or a guided decision tree." primaryTab="fix-it">
  <div class="mx-auto max-w-[1400px] px-4 py-10 sm:px-6 sm:py-14">
    <div data-reveal class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-[var(--color-ink)] sm:text-4xl">Fix It</h1>
      <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-[var(--color-ink-muted)]">
        Everyone breaks Git sometimes. Search for your situation, or answer a couple of questions and we'll point you at the exact fix.
      </p>
    </div>

    <div data-reveal class="mb-12">
      <DecisionTree base={url('/fix-it')} client:visible />
    </div>

    <div data-reveal>
      <h2 class="mb-4 text-lg font-bold text-[var(--color-ink)]">Or browse every fix</h2>
      <FixList entries={entries} base={url('/fix-it')} client:visible />
    </div>
  </div>
</Layout>
