---
import { getCollection } from 'astro:content';
import TopicPage from '../../layouts/TopicPage.astro';

export async function getStaticPaths() {
  const topics = await getCollection('topics', ({ data }) => data.primaryTab === 'workflows' && !data.draft);
  return topics.map((entry) => ({
    params: { slug: entry.id.split('/').pop() },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<TopicPage entry={entry} />
