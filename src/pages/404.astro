---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/ui/Icon.astro';
import { url } from '../lib/nav';
---

<Layout title="Page not found" description="This page doesn't exist." noIndex>
  <div class="mx-auto flex min-h-[60vh] max-w-lg flex-col items-center justify-center px-4 text-center">
    <span class="mb-5 grid h-16 w-16 place-items-center rounded-2xl bg-[var(--color-bg-elevated)] text-[var(--color-git-orange-soft)]">
      <Icon name="git-branch" size={28} />
    </span>
    <h1 class="text-3xl font-bold text-[var(--color-ink)]">404 — detached HEAD</h1>
    <p class="mt-3 text-[15px] leading-relaxed text-[var(--color-ink-muted)]">
      This page doesn't exist on any branch. Let's get you back to a real ref.
    </p>
    <a href={url('/')} data-magnetic class="btn-magnetic mt-7 rounded-xl bg-gradient-to-r from-[var(--color-git-orange)] to-[var(--color-violet)] px-6 py-3 text-sm font-semibold text-black">
      git switch main
    </a>
  </div>
</Layout>
