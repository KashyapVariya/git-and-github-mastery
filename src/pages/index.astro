---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/ui/Icon.astro';
import TerminalHero from '../components/home/TerminalHero.tsx';
import CommitGraph from '../components/home/CommitGraph.astro';
import InstallTabs from '../components/home/InstallTabs.astro';
import PathSelector from '../components/home/PathSelector.astro';
import ProgressRing from '../components/ui/ProgressRing.tsx';
import { primaryTabs, url } from '../lib/nav';

const allTopics = await getCollection('topics', ({ data }) => !data.draft);
const allSlugs = allTopics.map((t) => t.id);

const explore = primaryTabs.filter((t) => t.slug !== 'start-here');
const iconFor: Record<string, any> = {
  git: 'git-branch', github: 'github', workflows: 'route', 'fix-it': 'wrench',
  'cheat-sheet': 'list', playground: 'play', 'learning-path': 'map', resources: 'book',
};
---

<Layout title="Git Mastery" description="A dark, animation-rich home for learning every bit of Git and GitHub — from your first commit to internals, CI/CD, and team workflows.">
  <!-- HERO -->
  <section class="relative overflow-hidden px-4 pb-16 pt-14 sm:px-6 sm:pt-20">
    <div class="mx-auto grid max-w-[1400px] items-center gap-10 lg:grid-cols-2">
      <div data-reveal>
        <span class="chip mb-5 inline-flex border-[var(--color-git-orange)]/40 bg-[var(--color-git-orange)]/10 text-[var(--color-git-orange-soft)]">
          <Icon name="sparkles" size={13} /> 90+ topics · zero fluff
        </span>
        <h1 class="text-[2.6rem] font-bold leading-[1.08] tracking-tight sm:text-6xl">
          Master <span class="shimmer-text">Git</span> &amp;
          <span class="text-gradient">GitHub</span>,
          properly.
        </h1>
        <p class="mt-5 max-w-lg text-[16px] leading-relaxed text-[var(--color-ink-muted)]">
          One organized, animated home to learn every command and concept — explained simply, shown visually, and ready to practice. From your first <code class="inline-code">git init</code> to rewriting history and shipping with Actions.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a data-magnetic href={url('/git/fundamentals')} class="btn-magnetic rounded-xl bg-gradient-to-r from-[var(--color-git-orange)] to-[var(--color-violet)] px-6 py-3 text-sm font-semibold text-black">
            Start learning
          </a>
          <a data-magnetic href={url('/playground')} class="btn-magnetic flex items-center gap-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-6 py-3 text-sm font-semibold text-[var(--color-ink)] hover:border-[var(--color-git-orange)]/50">
            <Icon name="play" size={15} /> Try the playground
          </a>
        </div>
        {allSlugs.length > 0 && (
          <div class="mt-8 inline-flex items-center gap-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)]/60 px-4 py-3">
            <ProgressRing slugs={allSlugs} label="overall progress" client:visible />
          </div>
        )}
      </div>

      <div data-reveal class="grid gap-4">
        <TerminalHero client:visible />
        <div class="h-[220px]"><CommitGraph /></div>
      </div>
    </div>
  </section>

  <!-- GIT VS GITHUB -->
  <section class="px-4 py-14 sm:px-6">
    <div class="mx-auto max-w-[1400px]">
      <h2 data-reveal class="mb-2 text-2xl font-bold sm:text-3xl">Two different things, one workflow</h2>
      <p data-reveal class="mb-8 max-w-2xl text-[15px] text-[var(--color-ink-muted)]">
        People say "Git and GitHub" like one word, but they solve different problems. Knowing the split makes everything else click faster.
      </p>
      <div class="grid gap-5 sm:grid-cols-2">
        <div data-reveal data-tilt class="glass-card p-6 [transform-style:preserve-3d]">
          <div class="mb-3 flex items-center gap-2 text-[var(--color-git-orange-soft)]">
            <Icon name="git-branch" size={20} />
            <h3 class="text-lg font-semibold text-[var(--color-ink)]">Git</h3>
          </div>
          <p class="text-[14.5px] leading-relaxed text-[var(--color-ink-muted)]">
            Git is the <strong class="text-[var(--color-ink)]">version control tool itself</strong> — a program that runs on your machine and tracks every change to your files over time. It works completely offline: no account, no internet, no server required. You could use Git for the rest of your career without ever touching GitHub.
          </p>
        </div>
        <div data-reveal data-tilt class="glass-card p-6 [transform-style:preserve-3d]">
          <div class="mb-3 flex items-center gap-2 text-[var(--color-violet)]">
            <Icon name="github" size={20} />
            <h3 class="text-lg font-semibold text-[var(--color-ink)]">GitHub</h3>
          </div>
          <p class="text-[14.5px] leading-relaxed text-[var(--color-ink-muted)]">
            GitHub is a <strong class="text-[var(--color-ink)]">website and service built around Git</strong>. It hosts your repositories online so teams can collaborate, adds pull requests and code review, automates work with Actions, and layers on project management, security scanning, and more.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- INSTALL + SETUP -->
  <section class="px-4 py-14 sm:px-6">
    <div class="mx-auto grid max-w-[1400px] gap-8 lg:grid-cols-2">
      <div data-reveal>
        <h2 class="mb-2 text-2xl font-bold sm:text-3xl">Install Git</h2>
        <p class="mb-6 max-w-md text-[15px] text-[var(--color-ink-muted)]">Pick your operating system. One command, and you're set.</p>
        <InstallTabs />
      </div>
      <div data-reveal>
        <h2 class="mb-2 text-2xl font-bold sm:text-3xl">First-time setup</h2>
        <p class="mb-6 max-w-md text-[15px] text-[var(--color-ink-muted)]">Tell Git who you are — this gets attached to every commit you make.</p>
        <div class="code-block-wrapper gradient-border p-4">
          <pre class="!m-0 overflow-x-auto font-mono text-[13px] leading-loose text-[var(--color-ink-muted)]"><code><span class="text-[var(--color-git-orange-soft)]">git config --global user.name</span> "Ada Lovelace"
<span class="text-[var(--color-git-orange-soft)]">git config --global user.email</span> "ada@example.com"
<span class="text-[var(--color-git-orange-soft)]">git config --global init.defaultBranch</span> main</code></pre>
        </div>
        <p class="mt-4 text-[13.5px] text-[var(--color-ink-faint)]">
          <code class="inline-code">--global</code> applies this to every repository on your machine. Drop it inside a specific project to override just that one.
        </p>
      </div>
    </div>
  </section>

  <!-- LEARNING PATH SELECTOR -->
  <section class="px-4 py-14 sm:px-6">
    <div class="mx-auto max-w-[1400px]">
      <h2 data-reveal class="mb-2 text-2xl font-bold sm:text-3xl">Choose your starting point</h2>
      <p data-reveal class="mb-8 max-w-2xl text-[15px] text-[var(--color-ink-muted)]">Be honest about where you are today — you can always jump ahead later.</p>
      <div data-reveal>
        <PathSelector />
      </div>
    </div>
  </section>

  <!-- EXPLORE GRID -->
  <section class="px-4 py-14 sm:px-6">
    <div class="mx-auto max-w-[1400px]">
      <h2 data-reveal class="mb-8 text-2xl font-bold sm:text-3xl">Everything on this site</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {explore.map((tab) => (
          <a href={url(tab.href)} data-reveal data-tilt class="glass-card flex flex-col gap-3 p-5 [transform-style:preserve-3d]">
            <span class="grid h-10 w-10 place-items-center rounded-lg bg-[var(--color-bg-elevated)] text-[var(--color-git-orange-soft)]">
              <Icon name={iconFor[tab.slug]} size={18} />
            </span>
            <h3 class="text-[15px] font-semibold text-[var(--color-ink)]">{tab.label}</h3>
            <p class="text-[13px] text-[var(--color-ink-muted)]">{tab.hint}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
